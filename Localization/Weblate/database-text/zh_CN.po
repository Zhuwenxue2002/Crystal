#. 数据库字段：Item[963].ToolTip
#: Server.MirDB Item[963].ToolTip
msgctxt "Item:963:ToolTip"
msgid "Increase Experience by 5% for 1 hour."
msgstr "经验提高 5%，持续 1 小时。"

#. 数据库字段：Item[964].ToolTip
#: Server.MirDB Item[964].ToolTip
msgctxt "Item:964:ToolTip"
msgid "Increase DropRate by 10% for 1 hour."
msgstr "掉落率提高 10%，持续 1 小时。"

#. 数据库字段：Item[965].ToolTip
#: Server.MirDB Item[965].ToolTip
msgctxt "Item:965:ToolTip"
msgid "Increase MaxHP by 50 for 1 hour."
msgstr "最大 HP 提高 50，持续 1 小时。"

#. 数据库字段：Item[966].ToolTip
#: Server.MirDB Item[966].ToolTip
msgctxt "Item:966:ToolTip"
msgid "Increase MaxMP by 50 for 1 hour."
msgstr "最大 MP 提高 50，持续 1 小时。"

#. 数据库字段：Item[967].ToolTip
#: Server.MirDB Item[967].ToolTip
msgctxt "Item:967:ToolTip"
msgid "Increase AC 1-1 for 1 hour."
msgstr "防御提高 1-1，持续 1 小时。"

#. 数据库字段：Item[968].ToolTip
#: Server.MirDB Item[968].ToolTip
msgctxt "Item:968:ToolTip"
msgid "Increase AMC 1-1 for 1 hour."
msgstr "魔防提高 1-1，持续 1 小时。"

#. 数据库字段：Item[969].ToolTip
#: Server.MirDB Item[969].ToolTip
msgctxt "Item:969:ToolTip"
msgid "Increase Speed for 30m."
msgstr "速度提高，持续 30 分钟。"

#. 数据库字段：Item[970].ToolTip
#: Server.MirDB Item[970].ToolTip
msgctxt "Item:970:ToolTip"
msgid "Increase BagWeight by 3 for 5 hours."
msgstr "背包负重提高 3，持续 5 小时。"

#. 数据库字段：Item[971].ToolTip
#: Server.MirDB Item[971].ToolTip
msgctxt "Item:971:ToolTip"
msgid "Increase BagWeight by 5 for 5 hours."
msgstr "背包负重提高 5，持续 5 小时。"

#. 数据库字段：Item[972].ToolTip
#: Server.MirDB Item[972].ToolTip
msgctxt "Item:972:ToolTip"
msgid "Increase BagWeight by 9 for 5 hours."
msgstr "背包负重提高 9，持续 5 小时。"

#. 数据库字段：Item[973].ToolTip
#: Server.MirDB Item[973].ToolTip
msgctxt "Item:973:ToolTip"
msgid "Hitting Accuracy is increased per spell level."
msgstr "命中准确随技能等级提升。"

#. 数据库字段：Item[974].ToolTip
#: Server.MirDB Item[974].ToolTip
msgctxt "Item:974:ToolTip"
msgid "Your weapon becomes infused with strength"
msgstr "你的武器将注入强大力量。"

#. 数据库字段：Item[975].ToolTip
#: Server.MirDB Item[975].ToolTip
msgctxt "Item:975:ToolTip"
msgid "Increases the distance of your attack"
msgstr "增加你的攻击距离。"

#. 数据库字段：Item[976].ToolTip
#: Server.MirDB Item[976].ToolTip
msgctxt "Item:976:ToolTip"
msgid "Curves the swing of the weapon allowing\r\nyou to hit up to 4 targets at once.\r\n"
msgstr "挥出弧形攻击，最多可同时命中 4 个目标。\r\n"

#. 数据库字段：Item[977].ToolTip
#: Server.MirDB Item[977].ToolTip
msgctxt "Item:977:ToolTip"
msgid "Charge at your target pushing them back"
msgstr "冲向目标并将其击退。"

#. 数据库字段：Item[978].ToolTip
#: Server.MirDB Item[978].ToolTip
msgctxt "Item:978:ToolTip"
msgid "The weapon performs 2 swings in one motion.\r\nTarget has a chance of becoming stunned\r\nallowing more damage."
msgstr "武器一次动作挥砍两次。\r\n目标有几率被击晕并受到更多伤害。"

#. 数据库字段：Item[979].ToolTip
#: Server.MirDB Item[979].ToolTip
msgctxt "Item:979:ToolTip"
msgid "Paralyses mobs and pulls them towards \r\nthe caster."
msgstr "麻痹怪物并将其拉向施法者。"

#. 数据库字段：Item[980].ToolTip
#: Server.MirDB Item[980].ToolTip
msgctxt "Item:980:ToolTip"
msgid "Summons the spirit of fire causing a devastating\r\nblow to the target."
msgstr "召唤火焰之灵，对目标造成毁灭性一击。"

#. 数据库字段：Item[981].ToolTip
#: Server.MirDB Item[981].ToolTip
msgctxt "Item:981:ToolTip"
msgid "The warrior lets out a bellowing roar"
msgstr "战士发出震慑怒吼。"

#. 数据库字段：Item[982].ToolTip
#: Server.MirDB Item[982].ToolTip
msgctxt "Item:982:ToolTip"
msgid "Perform 2 curving swings with their weapon\r\nallowing them to hit up to 8 targets at once."
msgstr "使用武器连续挥出两道弧形攻击，最多可同时命中 8 个目标。"

#. 数据库字段：Item[983].ToolTip
#: Server.MirDB Item[983].ToolTip
msgctxt "Item:983:ToolTip"
msgid "Performs a thrust like action in 3 directions."
msgstr "向 3 个方向发动刺击。"

#. 数据库字段：Item[984].ToolTip
#: Server.MirDB Item[984].ToolTip
msgctxt "Item:984:ToolTip"
msgid "Warrior enters a hardened state of mind where\r\nany physical damage taken is reduced."
msgstr "战士进入坚韧状态，受到的物理伤害降低。"

#. 数据库字段：Item[985].ToolTip
#: Server.MirDB Item[985].ToolTip
msgctxt "Item:985:ToolTip"
msgid "Warrior enters a enraged state of mind where\r\neach weapon swing hits harder."
msgstr "战士进入狂怒状态，每次挥击伤害更高。"

#. 数据库字段：Item[986].ToolTip
#: Server.MirDB Item[986].ToolTip
msgctxt "Item:986:ToolTip"
msgid "Improves all defenses and has a chance\r\nto reflect damage to the attacker."
msgstr "提高所有防御，并有几率将伤害反弹给攻击者。"

#. 数据库字段：Item[987].ToolTip
#: Server.MirDB Item[987].ToolTip
msgctxt "Item:987:ToolTip"
msgid "Warrior charges into his foes parting them\r\nlike waves while dealing additional damage."
msgstr "战士冲入敌群，将敌人劈开并造成额外伤害。"

#. 数据库字段：Item[988].ToolTip
#: Server.MirDB Item[988].ToolTip
msgctxt "Item:988:ToolTip"
msgid "Increases the warriors attack speed for\r\na set period of time. "
msgstr "在一段时间内提高战士的攻击速度。"

#. 数据库字段：Item[990].ToolTip
#: Server.MirDB Item[990].ToolTip
msgctxt "Item:990:ToolTip"
msgid "Long distance attack by hurling a fireball"
msgstr "投掷火球进行远程攻击。"

#. 数据库字段：Item[991].ToolTip
#: Server.MirDB Item[991].ToolTip
msgctxt "Item:991:ToolTip"
msgid "Pushes away monsters and people surrounding\r\nyou."
msgstr "推开周围的怪物和玩家。"

#. 数据库字段：Item[992].ToolTip
#: Server.MirDB Item[992].ToolTip
msgctxt "Item:992:ToolTip"
msgid "Stuns and confuses monsters. Can also be\r\nused to tame monsters."
msgstr "击晕并迷惑怪物，也可用于驯服怪物。"

#. 数据库字段：Item[993].ToolTip
#: Server.MirDB Item[993].ToolTip
msgctxt "Item:993:ToolTip"
msgid "A powerful version of the Fireball spell."
msgstr "火球术的强化版本。"

#. 数据库字段：Item[994].ToolTip
#: Server.MirDB Item[994].ToolTip
msgctxt "Item:994:ToolTip"
msgid "Throws a column of flame 5 squares straight\r\nahead of the caster."
msgstr "向施法者前方 5 格释放一道火柱。"

#. 数据库字段：Item[995].ToolTip
#: Server.MirDB Item[995].ToolTip
msgctxt "Item:995:ToolTip"
msgid "Calls a thunderbolt to attack target from the sky."
msgstr "召唤天雷攻击目标。"

#. 数据库字段：Item[996].ToolTip
#: Server.MirDB Item[996].ToolTip
msgctxt "Item:996:ToolTip"
msgid "Spell that moves you randomly within a province\r\nand used to escape dungeons."
msgstr "在省内随机移动的法术，可用于逃离地牢。"

#. 数据库字段：Item[997].ToolTip
#: Server.MirDB Item[997].ToolTip
msgctxt "Item:997:ToolTip"
msgid "Creates an explosion of fire in 3x3 square causing\r\ndamage in its range.\r\n"
msgstr "在 3x3 范围内制造火焰爆炸并造成伤害。\r\n"

#. 数据库字段：Item[998].ToolTip
#: Server.MirDB Item[998].ToolTip
msgctxt "Item:998:ToolTip"
msgid "Creates a wall of fire on the ground."
msgstr "在地面上制造一道火墙。"

#. 数据库字段：Item[999].ToolTip
#: Server.MirDB Item[999].ToolTip
msgctxt "Item:999:ToolTip"
msgid "The caster creates a bolt of lightning"
msgstr "施法者凝聚一道闪电。"

#. 数据库字段：Item[1000].ToolTip
#: Server.MirDB Item[1000].ToolTip
msgctxt "Item:1000:ToolTip"
msgid "Casts a ball of ice which damages the target \r\nwith a chance of impairing their movement \r\nspeed or freezing them."
msgstr "释放冰球伤害目标，并有几率降低其移动速度或将其冻结。"

#. 数据库字段：Item[1001].ToolTip
#: Server.MirDB Item[1001].ToolTip
msgctxt "Item:1001:ToolTip"
msgid "A spell that creates a thunder storm around the\r\ncaster causing a shock on monsters into a\r\nstate of confusion."
msgstr "在施法者周围制造雷暴，使怪物受到电击并陷入混乱。"

#. 数据库字段：Item[1002].ToolTip
#: Server.MirDB Item[1002].ToolTip
msgctxt "Item:1002:ToolTip"
msgid "Creates a protective field around caster that\r\nabsorbs any damage taken."
msgstr "在施法者周围制造护盾，吸收受到的伤害。"

#. 数据库字段：Item[1003].ToolTip
#: Server.MirDB Item[1003].ToolTip
msgctxt "Item:1003:ToolTip"
msgid "Chance to kill any undead mob that meets the\r\nlevel requirements in a single cast."
msgstr "有几率一击消灭满足等级要求的不死怪物。"

#. 数据库字段：Item[1004].ToolTip
#: Server.MirDB Item[1004].ToolTip
msgctxt "Item:1004:ToolTip"
msgid "Draws health from the victim to replenish the\r\ncasters own health."
msgstr "从受害者身上汲取生命，恢复施法者自身生命。"

#. 数据库字段：Item[1005].ToolTip
#: Server.MirDB Item[1005].ToolTip
msgctxt "Item:1005:ToolTip"
msgid "Casts a powerful ice storm that circles the\r\nenemy causing damage on rotation."
msgstr "释放强力冰风暴环绕敌人并持续造成伤害。"

#. 数据库字段：Item[1006].ToolTip
#: Server.MirDB Item[1006].ToolTip
msgctxt "Item:1006:ToolTip"
msgid "Casts a powerful column of fire that burns its\r\ntarget."
msgstr "释放强力火柱灼烧目标。"

#. 数据库字段：Item[1007].ToolTip
#: Server.MirDB Item[1007].ToolTip
msgctxt "Item:1007:ToolTip"
msgid "Summons an indentical clone of the caster\r\nwhich will aid with attacks."
msgstr "召唤与施法者相同的分身协助攻击。"

#. 数据库字段：Item[1008].ToolTip
#: Server.MirDB Item[1008].ToolTip
msgctxt "Item:1008:ToolTip"
msgid "Creates a huge burst of fire damaging anything\r\nin its range."
msgstr "制造巨大的火焰爆发，伤害范围内所有目标。"

#. 数据库字段：Item[1009].ToolTip
